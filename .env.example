# ============================================================
# STTM AI PLATFORM
# Environment Configuration Template
#
# IMPORTANT:
# - Never put real secrets in this file.
# - Copy this file to .env for local development.
# - .env is excluded from Git by .gitignore.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

STTM_APP_NAME=sttm-ai-platform

STTM_APP_ENV=development

STTM_APP_VERSION=0.1.0

STTM_DEBUG=false


# ============================================================
# DATABASE
# ============================================================

# SQLite is the initial persistence implementation.
#
# The repository layer must hide this implementation detail
# so that SQLite can later be replaced with PostgreSQL.

STTM_DATABASE_URL=sqlite:///./data/sttm.db

STTM_DATABASE_ECHO=false


# ============================================================
# GOOGLE CLOUD / VERTEX AI
# ============================================================

# Google Cloud project containing Vertex AI resources.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI regional endpoint.

GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI model used for semantic reasoning.
#
# Keep the model configurable because model selection may change
# independently from application code.

STTM_VERTEX_MODEL=gemini-2.5-flash

# Optional service-account credentials for local development.
#
# Prefer Application Default Credentials where possible:
#
#   gcloud auth application-default login
#
# If using a service-account JSON file, provide the local path.
# NEVER commit the actual JSON file to Git.

GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


# ============================================================
# VERTEX AI GENERATION SETTINGS
# ============================================================

STTM_LLM_TEMPERATURE=0.0

STTM_LLM_MAX_OUTPUT_TOKENS=4096

STTM_LLM_TIMEOUT_SECONDS=60

STTM_LLM_MAX_RETRIES=3


# ============================================================
# CONFIDENCE MANAGEMENT
# ============================================================

# Mappings below this confidence threshold are routed to
# human review.

STTM_HUMAN_REVIEW_THRESHOLD=0.80

# Minimum confidence required for an AI semantic decision
# to be accepted without additional conflict resolution.

STTM_AI_ACCEPTANCE_THRESHOLD=0.70


# ============================================================
# VALIDATION
# ============================================================

# Whether validation failures should block artifact generation.

STTM_BLOCK_ON_VALIDATION_ERROR=true

# Whether warnings should be included in generated STTM output.

STTM_INCLUDE_WARNINGS=true


# ============================================================
# STTM
# ============================================================

# The external STTM contract is fixed at 16 columns.

STTM_COLUMN_COUNT=16

# Generated artifacts directory.

STTM_ARTIFACT_DIRECTORY=./artifacts


# ============================================================
# LOGGING
# ============================================================

STTM_LOG_LEVEL=INFO

STTM_LOG_FORMAT=json

STTM_LOG_DIRECTORY=./logs


# ============================================================
# OBSERVABILITY
# ============================================================

STTM_ENABLE_METRICS=true

STTM_ENABLE_TRACING=false

STTM_ENABLE_AUDIT_LOG=true


# ============================================================
# CACHING
# ============================================================

STTM_ENABLE_CACHE=true

STTM_CACHE_DIRECTORY=./runtime/cache

# Prompt cache

STTM_ENABLE_PROMPT_CACHE=true

# LLM response cache

STTM_ENABLE_LLM_CACHE=true

# IR cache

STTM_ENABLE_IR_CACHE=true


# ============================================================
# LANGGRAPH
# ============================================================

# Enable LangGraph checkpointing.

STTM_ENABLE_CHECKPOINTING=true

# Directory used for local checkpoint persistence.

STTM_CHECKPOINT_DIRECTORY=./runtime/checkpoints


# ============================================================
# STREAMLIT
# ============================================================

STTM_STREAMLIT_TITLE=AI-Assisted STTM Platform

STTM_STREAMLIT_LAYOUT=wide


# ============================================================
# SECURITY
# ============================================================

# PII protection.

STTM_ENABLE_PII_PROTECTION=true

# Maximum prompt size sent to the LLM.

STTM_MAX_PROMPT_SIZE=50000


# ============================================================
# FILE UPLOADS
# ============================================================

STTM_UPLOAD_DIRECTORY=./runtime/uploads

STTM_MAX_UPLOAD_SIZE_MB=50


# ============================================================
# EXECUTION
# ============================================================

# Execution is optional in the initial STTM platform.
#
# The downstream code generator remains the primary consumer
# of the validated Logical Mapping IR.

STTM_EXECUTION_ENABLED=false


# ============================================================
# DEVELOPMENT
# ============================================================

STTM_ENABLE_DEMO_DATA=false

STTM_ENABLE_DEBUG_GRAPH=false
